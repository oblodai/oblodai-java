<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.oblodai</groupId>
  <artifactId>oblodai-sdk</artifactId>
  <version>1.3.0</version>
  <packaging>jar</packaging>

  <name>Oblodai Java SDK</name>
  <description>Official Java/Kotlin SDK for the Oblodai payment gateway: payment acceptance, payouts, static wallets, webhooks.</description>
  <url>https://github.com/oblodai/oblodai-java</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <organization>
    <name>Oblodai</name>
    <url>https://oblodai.com</url>
  </organization>

  <developers>
    <developer>
      <name>Oblodai</name>
      <email>dev@oblodai.com</email>
      <organization>Oblodai</organization>
      <organizationUrl>https://oblodai.com</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/oblodai/oblodai-java.git</connection>
    <developerConnection>scm:git:git@github.com:oblodai/oblodai-java.git</developerConnection>
    <url>https://github.com/oblodai/oblodai-java</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <jackson.version>2.17.2</jackson.version>
    <kotlin.version>1.9.24</kotlin.version>
    <coroutines.version>1.8.1</coroutines.version>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!--
      Kotlin extensions ship in the same jar. Both dependencies are optional: a Java project pulls
      neither, and a Kotlin project already has them.
    -->
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>${kotlin.version}</version>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-coroutines-core</artifactId>
      <version>${coroutines.version}</version>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-test-junit5</artifactId>
      <version>${kotlin.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Contract drift gate: the committed sources under src/main/java/com/oblodai/contract must be
        exactly what codegen/ produces from contract/contract.json. Runs before compilation, so a
        stale generated file fails the build rather than shipping.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>check-contract-drift</id>
            <phase>validate</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${project.basedir}/codegen/run.sh</executable>
              <arguments>
                <argument>--check</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Kotlin compiles first and sees the Java sources, so the extensions can be written against
        classes that have not been compiled yet; javac then compiles the Java half against the
        Kotlin output.
      -->
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <version>${kotlin.version}</version>
        <executions>
          <execution>
            <id>compile</id>
            <phase>process-sources</phase>
            <goals><goal>compile</goal></goals>
            <configuration>
              <sourceDirs>
                <sourceDir>${project.basedir}/src/main/kotlin</sourceDir>
                <sourceDir>${project.basedir}/src/main/java</sourceDir>
              </sourceDirs>
            </configuration>
          </execution>
          <execution>
            <id>test-compile</id>
            <phase>process-test-sources</phase>
            <goals><goal>test-compile</goal></goals>
            <configuration>
              <sourceDirs>
                <sourceDir>${project.basedir}/src/test/kotlin</sourceDir>
                <sourceDir>${project.basedir}/src/test/java</sourceDir>
                <sourceDir>${project.basedir}/examples/kotlin</sourceDir>
                <sourceDir>${project.basedir}/examples/java</sourceDir>
              </sourceDirs>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <jvmTarget>17</jvmTarget>
          <args>
            <arg>-Xjvm-default=all</arg>
          </args>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all,-serial,-processing</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!--
        The examples are compiled with the tests, so a change to the SDK that would break them fails
        the build instead of shipping a README that no longer works. Surefire ignores them: they are
        programs with a main, not tests.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-examples</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals>
            <configuration>
              <sources>
                <source>${project.basedir}/examples/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifestEntries>
              <Implementation-Title>oblodai-sdk</Implementation-Title>
              <Implementation-Version>${project.version}</Implementation-Version>
              <Automatic-Module-Name>com.oblodai.sdk</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>

      <!--
        Maven Central requires a javadoc jar. It is built on every `mvn package`, not only at
        release time, so a javadoc error is found by the ordinary build instead of on the day
        someone tries to publish.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.12.0</version>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals><goal>jar</goal></goals>
          </execution>
        </executions>
        <configuration>
          <source>17</source>
          <doclint>all,-missing</doclint>
          <quiet>true</quiet>
          <notimestamp>true</notimestamp>
          <sourcepath>${project.basedir}/src/main/java</sourcepath>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!--
    Publishing to Maven Central. Everything it needs lives in this profile and nowhere else, so an
    ordinary `mvn verify` neither resolves the plugins below nor asks for a signing key: the SDK
    builds and tests identically on a machine that has no Sonatype account at all.

      mvn -Prelease deploy         -Dgpg.keyname=<key>         -Dcentral.username=<token-user> -Dcentral.password=<token>

    See RELEASING.md for the full procedure.
  -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
                <configuration>
                  <!-- No interactive passphrase prompt: CI passes it in the agent or via -Dgpg.passphrase. -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.7.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- Upload and stop: a human presses "publish" in the Central portal. -->
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
            </configuration>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-deploy-plugin</artifactId>
            <version>3.1.2</version>
            <configuration>
              <!-- The central plugin does the uploading; the default deploy goal must not. -->
              <skip>true</skip>
            </configuration>
          </plugin>
        </plugins>
      </build>

      <distributionManagement>
        <repository>
          <id>central</id>
          <name>Maven Central</name>
          <url>https://central.sonatype.com/api/v1/publisher</url>
        </repository>
      </distributionManagement>
    </profile>
  </profiles>
</project>
